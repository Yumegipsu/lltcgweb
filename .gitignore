# Production auth (operator-only; contributors use llr_auth_offline.php via llr_auth_load.php)
llr_auth.php
tcg_sync.local.php
# Hostinger marker that flips API traffic to VPS — never commit an enabled marker by accident
USE_VPS_API
# Hostinger marker: disable live match writes (VPS match-primary cutover)
MATCH_WRITES_DISABLED

