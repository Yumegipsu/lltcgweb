# Love Live TCG — Hostinger Apache front
# Static assets stay on Hostinger. SSE uses VPS nginx TLS
# (https://stream.loveliveradio.ca/tcg/sync/stream). Optional Phase 2 API proxy below.

# Part 1D cutover: live match writes are blocked on Hostinger by the untracked
# MATCH_WRITES_DISABLED marker next to api.php. Do not add a SetEnv fallback here:
# the VPS match host serves this same repo with AllowOverride All, so anything set
# in this file also disables writes on the host that actually owns the rooms.

# VPS match API (Docker docroot behind nginx /tcg/api/) — never serve the playable
# UI shell. Host is stream.loveliveradio.ca; Hostinger apex/www are unaffected.
<IfModule mod_headers.c>
  <If "%{HTTP_HOST} == 'stream.loveliveradio.ca'">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  </If>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /tcg/

  # Match host: blank root / index; robots Disallow; block static UI trees.
  # Substitutions are site-root absolute so they work when this file is the
  # Docker docroot .htaccess (RewriteBase /tcg/ would otherwise break paths).
  RewriteCond %{HTTP_HOST} ^stream\.loveliveradio\.ca$ [NC]
  RewriteRule ^robots\.txt$ /match_host_robots.txt [L]

  RewriteCond %{HTTP_HOST} ^stream\.loveliveradio\.ca$ [NC]
  RewriteRule ^$ /match_host_blank.php [L]

  RewriteCond %{HTTP_HOST} ^stream\.loveliveradio\.ca$ [NC]
  RewriteRule ^index\.html$ /match_host_blank.php [L]

  RewriteCond %{HTTP_HOST} ^stream\.loveliveradio\.ca$ [NC]
  RewriteCond %{REQUEST_URI} !^/(api|account|spectate|bannerimg|cardimg|cardimg_cache|replay)\.php(?:$|\?) [NC]
  RewriteCond %{REQUEST_URI} !^/match_host_blank\.php$ [NC]
  RewriteCond %{REQUEST_URI} !^/match_host_robots\.txt$ [NC]
  RewriteCond %{REQUEST_URI} !^/robots\.txt$ [NC]
  RewriteRule ^ - [R=404,L]

  # Optional: Apache proxy to VPS SSE (often unavailable on shared Hostinger — clients prefer stream.loveliveradio.ca)
  # RewriteRule ^sync-stream$ https://stream.loveliveradio.ca/tcg/sync/stream [P,QSA,L]

  # Phase 2: dynamic PHP API on VPS. Enabled when USE_VPS_API exists.
  # Always address the VPS by hostname (its nginx TLS front), never by origin IP.
  # Prefer flipping client TCG_API_ORIGIN to https://stream.loveliveradio.ca/tcg/api when ready.
  RewriteCond %{DOCUMENT_ROOT}/tcg/USE_VPS_API -f
  RewriteRule ^(api|account|spectate|bannerimg|cardimg|cardimg_cache|replay)\.php$ https://stream.loveliveradio.ca/tcg/api/$1.php [P,QSA,L]
</IfModule>

<IfModule mod_authz_core.c>
  RedirectMatch 403 (?i)^/tcg/(data|games|experiment_decks)/
</IfModule>

# Developer trees are deployed alongside the app but must never be served: the PHP
# under tests/ and scripts/ fatals when hit over HTTP (each one burns a worker and
# an error-log entry), and the docs describe deploy hosts. Browser assets live in
# client/, assets/ and icons/, so nothing here is needed by the page.
RedirectMatch 403 (?i)^/tcg/(tests|docs|scripts|src|migrations|node_modules|\.git)(/|$)
RedirectMatch 403 (?i)^/tcg/.*\.(md|lock|dist|sql|sh|py|mjs)$
RedirectMatch 403 (?i)^/tcg/(composer\.json|package(-lock)?\.json|phpunit\.xml)$
